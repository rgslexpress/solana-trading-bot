# =====================================================================
# Robô de trading Solana/Jupiter — EXEMPLO. Copie para .env (nunca versionar o .env).
# Segredos reais NUNCA devem ir para este arquivo de exemplo.
# =====================================================================

# --- Modo de execução: paper (padrão) | backtest | live ---------------
BOT_MODE=paper
# LIVE exige TAMBÉM: BOT_LIVE_CONFIRM=EU_ENTENDO_QUE_ISTO_USA_FUNDOS_REAIS e a flag --confirm-live na linha de comando.
BOT_LIVE_CONFIRM=

# --- Geral --------------------------------------------------------------
BOT_DB_PATH=data/bot.sqlite3
BOT_REPORTS_DIR=reports
BOT_LOG_LEVEL=INFO
BOT_LOG_JSON=true
BOT_LOG_FILE=logs/bot.log
BOT_TOKENS_FILE=config/tokens.json
BOT_QUOTE_SYMBOL=USDC
BOT_PAPER_CAPITAL=1000
BOT_POLL_SECONDS=30

# --- Fonte de dados: synthetic (só demonstração) | csv | geckoterminal --
BOT_DATA_SOURCE=csv
BOT_DATA_CSV_DIR=data
BOT_DATA_CACHE_TTL_S=30
BOT_DATA_HISTORY_CANDLES=600
# Liquidez (USD) da pool. CSV: premissa MANUAL (0 = desconhecida => o robô NÃO opera). Gecko: teto conservador.
BOT_DATA_LIQUIDITY_USD_OVERRIDE=0

# --- Solana / Jupiter (somente LIVE) -----------------------------------
BOT_RPC_URL=https://api.mainnet-beta.solana.com
BOT_JUPITER_BASE_URL=https://api.jup.ag/swap/v2
BOT_JUPITER_API_KEY=
# Carteira DEDICADA ao robô, com saldo limitado. Chave PÚBLICA aqui; a privada via ARQUIVO (chmod 600) fora do repositório.
BOT_WALLET_PUBLIC_KEY=
BOT_WALLET_SECRET_FILE=
BOT_WALLET_SECRET=

# --- Alertas (opcionais) -----------------------------------------------
BOT_TELEGRAM_BOT_TOKEN=
BOT_TELEGRAM_CHAT_ID=

# --- Estratégia -----------------------------------------------------------
BOT_STRATEGY_ENTRY_TIMEFRAME=15m
BOT_STRATEGY_HTF_TIMEFRAME=1h
BOT_STRATEGY_EMA_FAST=9
BOT_STRATEGY_EMA_SLOW=21
BOT_STRATEGY_EMA_TREND=200
BOT_STRATEGY_MACD_FAST=12
BOT_STRATEGY_MACD_SLOW=26
BOT_STRATEGY_MACD_SIGNAL=9
BOT_STRATEGY_RSI_PERIOD=14
BOT_STRATEGY_RSI_BUY_MAX=65
BOT_STRATEGY_BB_PERIOD=20
BOT_STRATEGY_BB_STD=2.0
BOT_STRATEGY_ATR_PERIOD=14
BOT_STRATEGY_MIN_RELATIVE_VOLUME=0.8
BOT_STRATEGY_MIN_SCORE=6
BOT_STRATEGY_MAX_COST_BPS=60

# --- Risco ----------------------------------------------------------------
BOT_RISK_RISK_PER_TRADE_PCT=0.5
# Acima de 1% exige justificativa documentada (teto absoluto 2%):
BOT_RISK_RISK_ABOVE_1PCT_JUSTIFICATION=
BOT_RISK_MAX_TOTAL_EXPOSURE_PCT=50
BOT_RISK_MAX_TOKEN_EXPOSURE_PCT=20
BOT_RISK_MAX_OPEN_POSITIONS=3
BOT_RISK_DAILY_LOSS_LIMIT_PCT=2
BOT_RISK_MAX_CUMULATIVE_LOSS_PCT=10
BOT_RISK_MAX_TRADES_PER_DAY=6
BOT_RISK_MAX_CONSECUTIVE_LOSSES=3
BOT_RISK_COOLDOWN_MINUTES=240
BOT_RISK_MIN_FEE_RESERVE_SOL=0.02
BOT_RISK_MIN_ORDER_QUOTE=10
BOT_RISK_ATR_STOP_MULT=2.0
BOT_RISK_RR_TARGET=2.0
BOT_RISK_BREAKEVEN_TRIGGER_R=1.0
BOT_RISK_TRAILING_ACTIVATION_R=1.5
BOT_RISK_TRAILING_ATR_MULT=2.5

# --- Execução / custos / resiliência ---------------------------------------
BOT_EXECUTION_FEE_BPS=10
BOT_EXECUTION_NETWORK_FEE_QUOTE=0.05
BOT_EXECUTION_BASE_SLIPPAGE_BPS=10
BOT_EXECUTION_MAX_SLIPPAGE_BPS=50
BOT_EXECUTION_MAX_PRICE_IMPACT_BPS=100
BOT_EXECUTION_MIN_LIQUIDITY_USD=100000
BOT_EXECUTION_QUOTE_MAX_AGE_S=15
BOT_EXECUTION_MAX_PRICE_DEVIATION_BPS=100
# Teto absoluto por ordem (moeda de referência). Comece MUITO baixo no LIVE.
BOT_EXECUTION_MAX_ORDER_QUOTE=25
BOT_EXECUTION_HTTP_TIMEOUT_S=10
BOT_EXECUTION_MAX_RETRIES=3
BOT_EXECUTION_MAX_CONSECUTIVE_EXEC_FAILURES=3
# Programas extras permitidos nas transações (separados por vírgula). Fail-closed por padrão.
BOT_EXECUTION_EXTRA_ALLOWED_PROGRAMS=

# --- Parâmetros adicionados na auditoria ------------------------------------
BOT_DATA_CLOSE_GRACE_S=5
BOT_DATA_MAX_GAP_CANDLES=1
BOT_DATA_INCLUDE_EMPTY_INTERVALS=false
BOT_EXECUTION_BALANCE_DIVERGENCE_PCT=2
BOT_EXECUTION_SEND_SLIPPAGE_PARAM=true
# Mantenha true até validar a transação real da Jupiter com scripts/dry_run_quote.py
BOT_EXECUTION_STRICT_ROUTER_ARGS=true
BOT_BACKTEST_STOP_LATENCY_BPS=20
BOT_BACKTEST_EXECUTION_FAILURE_RATE=0

# --- Painel local (somente 127.0.0.1) ----------------------------------------
BOT_PANEL_PORT=8765

# --- News & Market Intelligence (opcional; só RESTRINGE entradas; nunca opera) -----------------
# off (padrão) | shadow (observa e registra o que mudaria, SEM efeito) | enforce (bloqueia entradas / reduz risco)
BOT_INTEL_MODE=off
BOT_INTEL_SOURCES_FILE=config/intel_sources.json
BOT_INTEL_REFRESH_INTERVAL_S=300
BOT_INTEL_SOURCE_TIMEOUT_S=8
BOT_INTEL_STALE_AFTER_S=1800
# block_entries (padrão, só vale em enforce) | warn_only
BOT_INTEL_UNAVAILABLE_POLICY=block_entries
BOT_INTEL_MIN_RELIABILITY_FOR_BLOCK=0.7
BOT_INTEL_CORROBORATION_MIN_SOURCES=2
BOT_INTEL_CAUTION_WINDOW_S=7200
# Multiplicador do risco em cautela: (0,1]. Valores > 1 são recusados.
BOT_INTEL_CAUTION_RISK_MULTIPLIER=0.5
# Identifique-se nas requisições (a SEC exige contato). Exemplo: "meu-robo-paper/1.0 (contato: voce@exemplo.com)"
BOT_INTEL_USER_AGENT=solana-trading-bot-paper/1.0 (pesquisa pessoal; sem negociacao real)

# --- News & Market Intelligence: saúde, contingência, coleta e macro dos EUA (todas opcionais) -------------------
# Nunca coloque chaves/segredos aqui: as fontes usadas não exigem chave.
# Contingência: fonte CRÍTICA fora por mais que isso (padrão 6 h) => estado de CONTINGÊNCIA (nunca libera operações sozinho).
BOT_INTEL_CONTINGENCY_AFTER_S=21600
# keep_restriction (padrão: mantém a restrição em vigor) | reduced_risk (EXPLÍCITO: libera entradas com risco reduzido)
BOT_INTEL_CONTINGENCY_POLICY=keep_restriction
BOT_INTEL_CONTINGENCY_RISK_MULTIPLIER=0.25
# Sucessos seguidos para considerar uma fonte recuperada
BOT_INTEL_RECOVERY_MIN_SUCCESSES=2
# Coleta em thread de fundo (o ciclo de trading nunca espera pela rede) e prazo TOTAL por requisição
BOT_INTEL_BACKGROUND_FETCH=true
BOT_INTEL_TOTAL_TIMEOUT_S=20
# Após HTTP 429: espera mínima (dobra a cada novo 429; Retry-After é respeitado)
BOT_INTEL_BACKOFF_BASE_S=900
BOT_INTEL_BACKOFF_MAX_S=21600
# caution (padrão: degradação da mainnet só reduz risco) | block (trata degradação como crítica)
BOT_INTEL_MAINNET_DEGRADED_POLICY=caution
# Macro EUA: calendário do operador e janelas de risco (segundos)
BOT_INTEL_MACRO_ENABLED=true
BOT_INTEL_MACRO_CALENDAR_FILE=config/macro_calendar.json
BOT_INTEL_MACRO_HIGH_PRE_S=1800
BOT_INTEL_MACRO_HIGH_POST_S=3600
BOT_INTEL_MACRO_MEDIUM_PRE_S=900
BOT_INTEL_MACRO_MEDIUM_POST_S=1800
# (0,1]: risco por operação dentro da janela de uma divulgação de ALTA importância
BOT_INTEL_MACRO_WINDOW_RISK_MULTIPLIER=0.5
# reduce (padrão) | block (bloqueia NOVAS entradas dentro da janela de alta importância)
BOT_INTEL_MACRO_HIGH_POLICY=reduce
# 0 = desligado; >0 = variação diária (bps) do rendimento de 2/10 anos que aciona cautela
BOT_INTEL_MACRO_YIELD_MOVE_BPS=0
